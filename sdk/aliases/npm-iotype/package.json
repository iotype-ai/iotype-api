{
  "name": "iotype",
  "version": "1.0.0",
  "description": "Alias for @iotype-ai/sdk — the official JavaScript/TypeScript SDK for the iotype API (Persian speech recognition, OCR, translation and text-to-speech).",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "README.md"],
  "engines": { "node": ">=18" },
  "keywords": ["iotype", "persian", "farsi", "asr", "speech-to-text", "speech-recognition", "ocr", "persian-ocr", "tts", "text-to-speech", "translation", "nlp"],
  "license": "MIT",
  "author": { "name": "iotype", "url": "https://iotype.com" },
  "homepage": "https://iotype.com/api-service",
  "repository": {
    "type": "git",
    "url": "https://github.com/iotype-ai/iotype-api.git",
    "directory": "sdk/aliases/npm-iotype"
  },
  "bugs": { "url": "https://github.com/iotype-ai/iotype-api/issues" },
  "dependencies": {
    "@iotype-ai/sdk": "^1.0.0"
  }
}
